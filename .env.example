# Raven backend config.
#
# Values below assume Raven runs INSIDE the ryvn-* Docker stack and reaches
# siblings by container name. For local dev (outside Docker), swap the hostnames
# for the reachable host/IP (e.g. http://localhost:4000/v1 or http://10.x.x.x:6333).

# LLM — chat model via ryvn-litellm (OpenAI-compatible). Single endpoint, no fallback.
OPENAI_API_KEY=sk-your-litellm-key
OPENAI_BASE_URL=http://ryvn-litellm:4000/v1
OPENAI_MODEL=qwen3-a3b
# Per-request timeout (s). No fallback, so allow long generations to finish.
LLM_TIMEOUT=90

# RAG / Embeddings — bge-m3 (1024-dim) via ryvn-litellm. The Qdrant collection is
# bound to this model/dimension; changing it requires wiping + re-indexing.
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://ryvn-litellm:4000/v1
EMBEDDING_API_KEY=sk-your-litellm-key

# Vector store — ryvn-qdrant. Use ":memory:" for ephemeral/local runs.
QDRANT_URL=http://ryvn-qdrant:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=raven_docs

# LangGraph checkpointer — Postgres (ryvn-postgres). Leave empty to fall back to a
# local SQLite file (data/sessions.db).
DATABASE_URL=postgresql://USER:PASSWORD@ryvn-postgres:5432/raven

# Firecrawl (web scrape/crawl). Point at your Firecrawl endpoint.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-local

# File system watch paths (comma-separated). Mount your docs into the container
# and point here, e.g. /data/docs.
WATCH_PATHS=/data/docs

# Notes vault (save_note tool). NOTES_DIR is the path INSIDE the container;
# RAVEN_NOTES_DIR is the host path bind-mounted there (see docker-compose.yml).
NOTES_DIR=/app/notes
RAVEN_NOTES_DIR=/home/max/raven-vault

# Indexed file extensions (comma-separated)
INDEXED_EXTENSIONS=.txt,.md,.pdf,.docx,.py,.js,.ts,.json,.csv

# API auth (leave empty to disable; set a random token for basic security)
API_KEY=

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Server
PORT=1802
