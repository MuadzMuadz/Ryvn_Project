# LLM — OpenAI-compatible endpoint (LiteLLM proxy, Ollama, etc.)
OPENAI_API_KEY=***REMOVED***
OPENAI_BASE_URL=http://***REMOVED***:4000/v1
OPENAI_MODEL=gpt-4o-mini

# Firecrawl (local docker)
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-local

# RAG / Embeddings (local, no API needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/vectors

# File system watch paths (comma-separated)
WATCH_PATHS=/home/maxzcv/Documents,/home/maxzcv/Downloads

# Indexed file extensions (comma-separated)
INDEXED_EXTENSIONS=.txt,.md,.pdf,.docx,.py,.js,.ts,.json,.csv
