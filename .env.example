# LLM — PRIMARY chat model (OpenAI-compatible: LiteLLM proxy, LM Studio, Ollama, ...)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_MODEL=gpt-4o-mini

# LLM — FALLBACK chat model. Used automatically when the primary errors or is
# unreachable (e.g. a remote proxy behind a VPN that's off). Leave base_url empty
# to disable. Unset fields fall back to the primary's value.
# FALLBACK_OPENAI_API_KEY=
# FALLBACK_OPENAI_BASE_URL=http://localhost:1234/v1
# FALLBACK_OPENAI_MODEL=
# Per-request timeout (s) for the primary so an unreachable primary fails fast.
LLM_TIMEOUT=12

# Firecrawl (local docker)
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-local

# RAG / Embeddings. EMBEDDING_BASE_URL/API_KEY default to the primary LLM's; set
# them explicitly to pin embeddings to a stable endpoint (the Chroma collection is
# bound to one embedding model/dimension).
EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=
CHROMA_PERSIST_DIR=./data/vectors

# File system watch paths (comma-separated)
WATCH_PATHS=/path/to/your/documents

# Where Raven writes its own notes (save_note tool). Defaults to ./data/notes;
# point it at an Obsidian vault to keep notes there.
# NOTES_DIR=/path/to/your/vault/Notes

# Indexed file extensions (comma-separated)
INDEXED_EXTENSIONS=.txt,.md,.pdf,.docx,.py,.js,.ts,.json,.csv

# API auth (leave empty to disable; set a random token for basic security)
API_KEY=

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Server
PORT=1802
